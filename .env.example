# Copy to .env next to the project, or set SAS_ENV_FILE to an absolute path.
# Empty endpoint values use backend defaults. Never use VITE_ for secrets.
YANDEX_TRANSLATE_ENDPOINT=
DEEPL_TRANSLATE_ENDPOINT=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_ENDPOINT=
GOOGLE_API_KEY=

# DeepL: deeplx (default without a key; local proxy on port 1188) or api.
# Google: batch (default without a key), web (legacy single endpoint) or api.
DEEPL_TRANSLATE_MODE=
GOOGLE_TRANSLATE_MODE=

# Optional compatibility with existing LibreTranslate connections.
LIBRE_TRANSLATE_ENDPOINT=
LIBRE_API_KEY=

# Metadata only; no text, URLs, credentials or response bodies are logged.
TRANSLATION_DEBUG=false
# Optional alternate web access configuration file; defaults to web-server.json.
# SAS_WEB_CONFIG=
# Web access key is configured as accessKey in web-server.json, not in .env.
# Empty accessKey allows entry without a key; IP rules still apply.
