{
  "name": "super-ai-story",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "description": "SAS — локальная студия персонажей, миров и LLM",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "desktop": "node scripts/launch-desktop.mjs",
    "test": "node --test --test-timeout=60000 tests/*.test.mjs",
    "package:win": "node scripts/build-release.mjs && node scripts/package-release.mjs",
    "package:web": "npm run build && node scripts/package-web.mjs",
    "web": "node server/web.mjs",
    "web:shell": "node server/web.mjs --shell",
    "prepare:models": "node scripts/prepare-llama.mjs",
    "prepare:speech": "node scripts/prepare-speech.mjs",
    "prepare:silero": "node scripts/prepare-silero.mjs",
    "package:app": "node scripts/build-release.mjs --app-only",
    "package:extension": "node scripts/package-extension.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "adm-zip": "^0.6.1",
    "espeak-ng": "^1.0.2",
    "express": "^5.1.0",
    "google-translate-api-x": "10.7.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "archiver": "7.0.1",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Padparaja-Ge",
    "url": "https://github.com/Padparaja-Ge"
  },
  "contributors": [
    {
      "name": "Wenzeslaus-first",
      "url": "https://github.com/Wenzeslaus-first"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Padparaja-Ge/Super-AI-Story.git"
  },
  "homepage": "https://github.com/Padparaja-Ge/Super-AI-Story#readme",
  "bugs": {
    "url": "https://github.com/Padparaja-Ge/Super-AI-Story/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
